#!/usr/bin/expect -f

set timeout 300

# 设置环境变量
set env(N_PREFIX) "$env(HOME)/.n"
set env(PATH) "$env(HOME)/.n/bin:$env(HOME)/.npm-global/bin:/usr/local/bin:/usr/bin:/bin"

spawn openclaw onboard --install-daemon

# 等待安全警告并选择 Yes
expect "Continue?"
send "y\r"

# 等待选择模式并选择 QuickStart (默认)
expect "QuickStart"
send "\r"

# 等待守护进程安装确认
expect -re "(install|Install|daemon)"
send "y\r"

# 等待完成
expect eof

puts "\n\n=== OpenClaw Onboarding Complete ===\n"
