    {
      "id": "ecu_pingpong_effect",
      "name": "ECU 乒乓效应",
      "description": "缺陷在不同 ECU 之间来回转派的现象，反映跨系统协调复杂性。ECU 转移次数越多，说明问题涉及的系统越多，解决难度越大。",
      "source_file": "data_processor.py",
      "field": "ecu_pingpong_count",
      "thresholds": [
        {
          "condition": ">=5 次",
          "score": 30,
          "level": "Extremely High",
          "meaning": "跨5+个ECU流转，极度复杂的协调问题"
        },
        {
          "condition": ">=3 次",
          "score": 24,
          "level": "High",
          "meaning": "跨3+个ECU流转，需要多团队协作"
        },
        {
          "condition": ">=1 次",
          "score": 20,
          "level": "Medium",
          "meaning": "至少跨1个ECU，有协调需求"
        },
        {
          "condition": "0 次",
          "score": 0,
          "level": "None",
          "meaning": "未发生ECU转移"
        }
      ],
      "business_meaning": "ECU乒乓效应是TopIssue风险评分的8个维度之一（权重30分）。高频乒乓通常意味着：1）问题根因定位困难 2）责任归属不清晰 3）需要升级管理关注。",
      "aliases": [
        "ECU乒乓",
        "ECU转移",
        "ECU transfer",
        "ECU bounce",
        "ecu_pingpong",
        "跨ECU"
      ]
    },
