        "risk level"
      ]
    },
    {
      "id": "topissue_scoring_dimensions",
      "name": "TopIssue 8维评分体系",
      "description": "TopIssue 风险评分的8个评估维度及其权重，使用非线性算法（指数衰减+对数增长+双峰分布+智能组合），总分无硬上限。",
      "source_file": "risk assessment/TopIssue_Risk_Scoring_Algorithm.md",
      "dimensions": [
        {
          "id": 1,
          "name": "Matrix Severity",
          "weight": 30,
          "scoring": "exponential_decay",
          "description": "指数衰减：score = 30 * exp(-0.25 * order)。order: 1A=0→30, 1B=1→24, 1C=2→18, 1D=3→14, 1E=4→11, 2A=5→9, 2B=6→7, 3A=7→5, 2D=8→4, 其余≤3分。高危等级分值差距更大。"
        },
        {
          "id": 2,
          "name": "Classification Labels",
          "weight": 30,
          "scoring": "threshold",
          "description": "Showstopper_Confirmed=30, Preventing Maturity Grade ConDrive=30, Showstopper_Candidate=20, Obstructing Maturity Grade ConDrive=10, Homologation L-labelled=10, Other=0"
        },
        {
          "id": 3,
          "name": "ECU Transfer Count",
          "weight": 30,
          "scoring": "threshold",
          "description": ">=5次=30, >=3次=24, >=1次=20, 0=0"
        },
        {
          "id": 4,
          "name": "Domain Transfer Count",
          "weight": 20,
          "scoring": "threshold",
          "description": ">=5次=20, >=3次=14, >=1次=10, 0=0"
        },
        {
          "id": 5,
          "name": "Parent Complexity",
          "weight": 30,
          "scoring": "logarithmic",
          "description": "对数增长：score = min(30, round(10 * ln(count+1) * 2.5))。1子票≈17分, 3子票→cap30分。边际递减。"
        },
        {
          "id": 6,
          "name": "Child Complexity",
          "weight": 30,
          "scoring": "logarithmic",
          "description": "对数增长：同Parent Complexity公式。score = min(30, round(10 * ln(count+1) * 2.5))。"
        },
        {
          "id": 7,
          "name": "Processing Cycle",
          "weight": 20,
          "scoring": "bimodal",
          "description": "双峰分布：新票0-3天=18-24分→低谷4-20天=5-15分→上升21-30天=15-20分→长期>30天=20-25分。>30天后每10天+2分，上限25分。"
        },
        {
          "id": 8,
          "name": "Shift PU Status",
          "weight": 10,
          "scoring": "binary",
          "description": "有值=10（推迟修复标识），无值=0"
        }
      ],
      "total_max_score": "非线性，无硬上限但通常<200",
      "formula": "基础: smart_combine(8维) + 非线性交互调整",
      "inheritance": "Child票会额外计算Master票的风险分，取两者中更高值",
      "combination_algorithm": "智能组合：高分项(>15分)算术平均×1.2 + 低分项(≤15分)几何平均×0.8。非线性调整：严重+长期+15分, 跨ECU+跨Domain+10分, 严重+阻塞+15分, >30天时间加速, >10子票复杂度阈值。"
    }
  ]
