          },
          {
            "name": "lead_model",
            "type": "TEXT",
            "meaning": "引领车型",
            "octane_source": "lead_model_udf.name"
          },
          {
            "name": "ecu_no_of_changes",
            "type": "INTEGER",
            "meaning": "ECU变更/转移次数(ECU乒乓)",
