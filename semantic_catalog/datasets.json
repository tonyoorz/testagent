            "octane_source": "detected_in_release.name"
          },
          {
            "name": "software_version",
            "type": "TEXT",
            "meaning": "被测软件版本",
            "octane_source": "software_version_udf"
          },
          {
            "name": "vin",
            "type": "TEXT",
            "meaning": "车辆识别码",
            "octane_source": "vin_udf"
          },
          {
