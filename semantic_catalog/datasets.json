          },
          {
            "name": "problem_finder_team",
            "type": "TEXT",
            "meaning": "发现问题的团队(problem_finder_team_udf)，与team不同：team是归属团队，problem_finder_team是实际发现问题的团队",
            "octane_source": "problem_finder_team_udf.name"
          },
          {
            "name": "program",
            "type": "TEXT",
            "meaning": "项目/程序(program字段)",
            "octane_source": "program"
          },
          {
            "name": "author",
            "type": "TEXT",
            "meaning": "创建者/提交者",
            "octane_source": "author.name/full_name"
          },
          {
            "name": "aida_businesskey",
            "type": "TEXT",
            "meaning": "AIDA业务键",
            "octane_source": "aida_businesskey_udf"
          },
          {
            "name": "aida_english",
            "type": "TEXT",
            "meaning": "AIDA英文名(从product_areas提取)",
            "note": "octane_db.py extract_english"
          },
          {
            "name": "top_aida",
            "type": "TEXT",
            "meaning": "主AIDA",
            "note": "octane_db.py提取"
          },
          {
            "name": "product_areas",
            "type": "TEXT",
            "meaning": "产品域/多值AIDA列表(JSON)",
            "octane_source": "product_areas"
          },
          {
            "name": "user_tags",
            "type": "TEXT",
            "meaning": "用户标签集合(含matrix-前缀)",
            "octane_source": "user_tags"
          },
          {
            "name": "phase",
            "type": "TEXT",
            "meaning": "Octane原始phase字段",
            "octane_source": "phase.name"
          },
          {
            "name": "severity",
            "type": "TEXT",
            "meaning": "Octane系统severity",
            "octane_source": "severity.name"
          },
          {
            "name": "problem_severity",
            "type": "TEXT",
            "meaning": "问题严重度",
            "octane_source": "problem_severity_udf.name"
          },
          {
            "name": "status_phase",
            "type": "TEXT",
            "meaning": "状态阶段(Agent查询状态的主要字段)",
            "octane_source": "phase.name"
          },
          {
            "name": "owner",
            "type": "TEXT",
            "meaning": "缺陷当前负责人",
            "octane_source": "owner.name/full_name"
          },
          {
            "name": "detected_by",
            "type": "TEXT",
            "meaning": "缺陷发现人/测试员",
            "octane_source": "detected_by.name/full_name"
          },
          {
            "name": "detected_in_release",
            "type": "TEXT",
