          },
          {
            "name": "solution_responsible",
            "type": "TEXT",
            "meaning": "解决方案负责人",
            "octane_source": "solution_responsible_udf.name"
          },
          {
            "name": "solution_cluster",
            "type": "TEXT",
            "meaning": "Solution Cluster/开发域",
            "octane_source": "solution_cluster_udf.name"
          },
          {
            "name": "reporting_class",
            "type": "TEXT",
            "meaning": "报告分类(可能含多个值,需LIKE)",
            "octane_source": "reporting_class_udf.data[].name"
          },
          {
            "name": "function_responsible",
            "type": "TEXT",
            "meaning": "功能负责人",
            "octane_source": "function_responsible1_udf.name"
          },
          {
            "name": "involved_i_step",
            "type": "TEXT",
            "meaning": "涉及I-Step/里程碑",
            "octane_source": "involved_i_step1_udf.name"
          },
          {
            "name": "first_use_sop_of_function",
            "type": "TEXT",
            "meaning": "首次使用SOP/PU目标",
            "octane_source": "first_use_sop_of_function_udf.name"
          },
          {
            "name": "tolerated_count",
            "type": "INTEGER",
            "meaning": "容忍次数",
            "octane_source": "tolerated_count_udf"
          },
          {
            "name": "reprel_changes",
            "type": "INTEGER",
            "meaning": "需求变更次数(高值=需求不稳定)",
            "octane_source": "reprel_changes_udf"
          },
          {
            "name": "raw_json",
            "type": "TEXT",
            "meaning": "Octane原始完整JSON"
          },
          {
            "name": "year",
            "type": "INTEGER",
            "meaning": "数据年份"
          },
          {
            "name": "fetched_at",
            "type": "TEXT",
            "meaning": "数据下载时间戳"
          }
        ],
        "columns_not_in_dataframe": [
          "problem_finder_team",
          "program",
          "author",
          "aida_businesskey",
          "function_responsible",
          "tolerated_count",
          "reprel_changes",
          "last_modified",
          "owner",
          "fvp",
          "tqr"
        ],
        "notes": [
          "优化表有44列DataFrame约25列差异在raw_json",
          "problem_finder_team vs team vs detected_by三者不同",
          "reporting_class是TEXT需LIKE匹配",
          "risk_score初始NULL需后续计算",
          "raw_json可json_parse获取未展平字段"
        ]
      }
