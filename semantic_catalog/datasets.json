{
  "schema_version": "1.0",
  "datasets": [
    {
      "id": "octane_defects",
      "name": "Octane Defects",
      "aliases": ["defects", "defect", "缺陷", "bug", "issue", "octane_defect", "work_item"],
      "description": "用于缺陷分析的主数据集，来自 Octane 缺陷导出或本地SQLite缓存。",
      "granularity": "一行=一个缺陷(work_item)",
      "primary_keys": ["id"],
      "time_columns": [
        {
          "name": "creation_time",
          "meaning": "缺陷创建时间",
          "type": "datetime"
        }
      ],
      "core_dimensions": [
        {
          "name": "project",
          "aliases": ["tproject", "项目", "车系", "车型", "project_name"],
          "meaning": "项目/车系映射后的项目字段",
          "type": "string"
        },
        {
          "name": "aida_english",
          "aliases": ["aida", "top_aida", "product_area", "产品域", "领域"],
          "meaning": "AIDA 英文名（从 AIDA 字段抽取，仅保留英文文字、去掉数字/编号；用于统一口径分析）",
          "type": "string"
        },
        {
          "name": "severity",
          "meaning": "缺陷严重度（如 Critical/Major/Minor）",
          "type": "string"
        },
        {
          "name": "status_phase",
          "aliases": ["phase", "status", "状态", "阶段", "lifecycle"],
          "meaning": "缺陷状态/阶段（phase字段映射）",
          "type": "string"
        },
        {
          "name": "fv",
          "aliases": ["feature team", "feature_team", "功能负责人", "负责人", "模块负责人", "dtsv"],
          "meaning": "Feature Team（DTSV 功能负责人/责任团队），用于表示该缺陷对应的功能负责人或负责团队",
          "type": "string"
        },
        {
          "name": "pu",
          "meaning": "PU / SOP字段（first_use_sop_of_function_udf映射）",
          "type": "string"
        },
        {
          "name": "tester",
          "aliases": ["detected_by", "found_by", "reporter", "发现人", "测试人员"],
          "meaning": "缺陷发现人/测试者（detected_by映射）",
          "type": "string"
        },
        {
          "name": "id",
          "aliases": ["ticket_id", "bug_id", "defect_id", "issue_id", "work_item_id"],
          "meaning": "Octane 缺陷/工单的 ID（ticket/bug 唯一编号）",
          "type": "string"
        },
        {
          "name": "test_week",
          "aliases": ["cw", "calendar_week", "测试周", "周"],
          "meaning": "测试周（CW 周编号），一年通常有 CW01-CW52 共 52 个测试周",
          "type": "string"
        },
        {
          "name": "aidas",
          "aliases": ["product_areas", "aida_list", "aida集合"],
          "meaning": "Octane 系统的 AIDA 多值集合字段：一个 ticket 可关联多个 AIDA",
          "type": "string"
        },
        {
          "name": "top_aida",
          "aliases": ["top aida", "主要aida", "主aida", "最重要aida"],
          "meaning": "团队口径的 Top AIDA：从 aidas 中抽取的主 AIDA，是测试团队定义的最小颗粒度（验证基石）",
          "type": "string"
        },
        {
          "name": "domain",
          "aliases": ["solution_cluster", "dev_team", "开发团队", "责任团队"],
          "meaning": "开发团队/责任团队（Solution Cluster 口径，用于标识负责开发/修复的团队）",
          "type": "string"
        },
        {
          "name": "matrix",
          "aliases": ["matrix_display", "severity_matrix", "严重矩阵", "严重性标签"],
          "meaning": "缺陷严重性矩阵标签（用于标识严重程度分层的规则标签）",
          "type": "string"
        },
        {
          "name": "software_version",
          "aliases": ["sw_version", "version", "软件版本", "被测版本"],
          "meaning": "被测软件版本（SUT 软件版本）",
          "type": "string"
        },
        {
          "name": "occurrence",
          "aliases": ["error_occurrence", "repro_rate", "复现率", "复现概率"],
          "meaning": "复现概率/复现频次（描述缺陷在测试中出现的概率）",
          "type": "string"
        },
        {
          "name": "solution",
          "aliases": ["solution_responsible", "解决方案负责人", "解决方案责任团队"],
          "meaning": "负责给出解决方案的开发团队/责任方（Solution Responsible）",
          "type": "string"
        },
        {
          "name": "parent_child",
          "aliases": ["parent_child_udf", "子票", "父子关系"],
          "meaning": "缺陷父子关系/Child 关联状态字段（用于描述 master-child 关系）",
          "type": "string"
        },
        {
          "name": "blocking_reason",
          "aliases": ["blocking_reason_udf", "blocked_reason", "阻塞原因"],
          "meaning": "缺陷/测试阻塞原因（导致无法推进验证或修复的原因）",
          "type": "string"
        },
        {
          "name": "ecu",
          "aliases": ["assigned_ecu", "ecu_name", "车内ECU"],
          "meaning": "测试车内 ECU 名称（缺陷关联 ECU / 负责 ECU）",
          "type": "string"
        },
        {
          "name": "release",
          "aliases": ["detected_in_release", "release_stage", "释放阶段"],
          "meaning": "当前软件释放的 Release 阶段（Detected in Release / Release Stage）",
          "type": "string"
        },
        {
          "name": "istep",
          "aliases": ["i_step", "milestone", "研发周期", "目标周期"],
          "meaning": "车型研发目标周期的里程碑（Milestone / I-Step）",
          "type": "string"
        },
        {
          "name": "lead_model",
          "aliases": ["lead_model_udf", "引领车型", "标准车型"],
          "meaning": "引领车型：软硬件 cluster 最先应用/落地的标准车型",
          "type": "string"
        },
        {
          "name": "tags",
          "aliases": ["user_tags", "标签", "tag_list"],
          "meaning": "Ticket 标签集合（用于分类、过滤或流程标记）",
          "type": "string"
        },
        {
          "name": "ticket_quality",
          "aliases": ["tqr", "tqr_udf", "quality", "缺陷质量"],
          "meaning": "缺陷质量（Ticket Quality / TQR，用于衡量缺陷描述、复现信息等质量）",
          "type": "string"
        }
      ],
      "field_lineage": {
        "occurrence": "error_occurrence_udf",
        "severity": "problem_severity_udf",
        "status_phase": "phase",
        "solution": "solution_responsible_udf",
        "parent_child": "parent_child_udf",
        "blocking_reason": "blocking_reason_udf",
        "pu": "first_use_sop_of_function_udf",
        "tester": "detected_by",
        "ecu": "assigned_ecu_udf",
        "release": "detected_in_release",
        "istep": "involved_i_step1_udf",
        "lead_model": "lead_model_udf",
        "software_version": "software_version_udf"
      },
      "list_field_lineage": {
        "tags": "user_tags",
        "ticket_quality": "tqr_udf",
        "aidas": "product_areas"
      },
      "common_columns": [
        "id",
        "creation_time",
        "test_week",
        "project",
        "aidas",
        "top_aida",
        "aida_english",
        "severity",
        "status_phase",
        "fv",
        "pu",
        "tester",
        "domain",
        "matrix",
        "software_version"
      ],
      "can_answer": [
        "不同时间/项目/AIDA/FV下缺陷数量趋势如何",
        "当前阶段分布、严重度分布是否异常",
        "高风险缺陷（按规则）集中在哪些域/团队/版本"
      ],
      "misuse_risks": [
        "仅用creation_time做趋势可能忽略状态迁移；需要明确口径（新增/存量/关闭）",
        "aida_english可能来自提取或映射，存在Unknown/不一致，需要在结论里标注覆盖率"
      ],
      "source": {
        "loader": "data_processor.load_defect_data",
        "default_file_pattern": "defect/2025_defect.json",
        "db_kind": "defects"
      },
      "optimized_table": {
        "table_name": "octane_defects",
        "description": "downloader下载原始JSON后由octane_db.py展平写入的优化查询表，Agent查询的主要目标",
        "columns": [
          {"name": "defect_id", "type": "TEXT", "pk": true, "meaning": "Octane缺陷唯一ID", "octane_source": "id"},
          {"name": "name", "type": "TEXT", "meaning": "缺陷标题/名称", "octane_source": "name"},
          {"name": "creation_time", "type": "TEXT", "meaning": "创建时间(ISO格式)", "octane_source": "creation_time"},
          {"name": "last_modified", "type": "TEXT", "meaning": "最后修改时间", "octane_source": "last_modified"},
          {"name": "team", "type": "TEXT", "meaning": "归属团队(Octane team字段)", "octane_source": "team.name"},
          {"name": "problem_finder_team", "type": "TEXT", "meaning": "发现问题的团队(problem_finder_team_udf)，与team不同：team是归属团队，problem_finder_team是实际发现问题的团队", "octane_source": "problem_finder_team_udf.name"},
          {"name": "program", "type": "TEXT", "meaning": "项目/程序(program字段)", "octane_source": "program"},
          {"name": "author", "type": "TEXT", "meaning": "创建者/提交者", "octane_source": "author.name/full_name"},
          {"name": "aida_businesskey", "type": "TEXT", "meaning": "AIDA业务键(aida_businesskey_udf)", "octane_source": "aida_businesskey_udf"},
          {"name": "aida_english", "type": "TEXT", "meaning": "AIDA英文名(从product_areas提取)", "note": "由octane_db.py的extract_english计算"},
          {"name": "top_aida", "type": "TEXT", "meaning": "主AIDA(从product_areas提取第一个)", "note": "由octane_db.py提取"},
          {"name": "product_areas", "type": "TEXT", "meaning": "产品域/多值AIDA列表(JSON字符串)", "octane_source": "product_areas"},
          {"name": "user_tags", "type": "TEXT", "meaning": "用户标签集合(含matrix-前缀标签)", "octane_source": "user_tags"},
          {"name": "phase", "type": "TEXT", "meaning": "Octane原始phase字段(可能含后缀)", "octane_source": "phase.name"},
          {"name": "severity", "type": "TEXT", "meaning": "Octane系统severity字段", "octane_source": "severity.name"},
          {"name": "problem_severity", "type": "TEXT", "meaning": "问题严重度(problem_severity_udf)", "octane_source": "problem_severity_udf.name"},
          {"name": "status_phase", "type": "TEXT", "meaning": "状态阶段(phase字段的name值，是Agent查询状态的主要字段)", "octane_source": "phase.name"},
          {"name": "owner", "type": "TEXT", "meaning": "缺陷当前负责人", "octane_source": "owner.name/full_name"},
          {"name": "detected_by", "type": "TEXT", "meaning": "缺陷发现人/测试员", "octane_source": "detected_by.name/full_name"},
          {"name": "detected_in_release", "type": "TEXT", "meaning": "发现时的Release阶段", "octane_source": "detected_in_release.name"},
          {"name": "software_version", "type": "TEXT", "meaning": "被测软件版本", "octane_source": "software_version_udf"},
          {"name": "vin", "type": "TEXT", "meaning": "车辆识别码(VIN)", "octane_source": "vin_udf"},
          {"name": "assigned_ecu", "type": "TEXT", "meaning": "分配的ECU", "octane_source": "assigned_ecu_udf.name"},
          {"name": "lead_model", "type": "TEXT", "meaning": "引领车型", "octane_source": "lead_model_udf.name"},
          {"name": "ecu_no_of_changes", "type": "INTEGER", "meaning": "ECU变更/转移次数(即ECU乒乓次数)", "octane_source": "ecu_no_of_changes_udf"},
          {"name": "parent_id", "type": "TEXT", "meaning": "父票/Master票ID", "octane_source": "parent.id"},
          {"name": "parent_child_type", "type": "TEXT", "meaning": "父子关系类型(parent_child_udf)", "octane_source": "parent_child_udf.name"},
          {"name": "relation_to", "type": "TEXT", "meaning": "关联关系(relation_to_udf,含子票ID列表)", "octane_source": "relation_to_udf"},
          {"name": "test_week", "type": "TEXT", "meaning": "测试周(从creation_time计算,格式YYYY-CWww)", "note": "由octane_db.py的_calc_test_week计算"},
          {"name": "risk_score", "type": "REAL", "meaning": "风险评分(由后续计算填入,初始为NULL)", "note": "非下载时生成，由风险评分算法计算后更新"},
          {"name": "fv", "type": "TEXT", "meaning": "Feature Team(从AIDA映射,非Octane原生)", "note": "由octane_db.py的assign_fv_from_aida映射"},
          {"name": "fvp", "type": "TEXT", "meaning": "FVP(从FV推导)", "note": "由octane_db.py的_get_fvp_from_fv计算"},
          {"name": "tqr", "type": "TEXT", "meaning": "Ticket Quality Rating(缺陷质量评分)", "octane_source": "tqr_udf"},
          {"name": "blocking_reason", "type": "TEXT", "meaning": "阻塞原因", "octane_source": "blocking_reason_udf.name"},
          {"name": "error_occurrence", "type": "TEXT", "meaning": "复现概率/频次", "octane_source": "error_occurrence_udf.name"},
          {"name": "solution_responsible", "type": "TEXT", "meaning": "解决方案负责人", "octane_source": "solution_responsible_udf.name"},
          {"name": "solution_cluster", "type": "TEXT", "meaning": "Solution Cluster/开发域", "octane_source": "solution_cluster_udf.name"},
          {"name": "reporting_class", "type": "TEXT", "meaning": "报告分类(列表类型,可能含多个值)", "octane_source": "reporting_class_udf.data[].name"},
          {"name": "function_responsible", "type": "TEXT", "meaning": "功能负责人(function_responsible1_udf)", "octane_source": "function_responsible1_udf.name"},
          {"name": "involved_i_step", "type": "TEXT", "meaning": "涉及的I-Step/里程碑", "octane_source": "involved_i_step1_udf.name"},
          {"name": "first_use_sop_of_function", "type": "TEXT", "meaning": "首次使用SOP/PU目标", "octane_source": "first_use_sop_of_function_udf.name"},
          {"name": "tolerated_count", "type": "INTEGER", "meaning": "容忍次数(tolerated_count_udf)", "octane_source": "tolerated_count_udf"},
          {"name": "reprel_changes", "type": "INTEGER", "meaning": "需求变更次数(reprel_changes_udf),需求频繁变更可能导致缺陷", "octane_source": "reprel_changes_udf"},
          {"name": "raw_json", "type": "TEXT", "meaning": "Octane原始完整JSON(可解析获取任何未展平字段)", "note": "JSON.parse(raw_json)可获取所有原始字段"},
          {"name": "year", "type": "INTEGER", "meaning": "数据年份"},
          {"name": "fetched_at", "type": "TEXT", "meaning": "数据下载时间戳"}
        ],
        "columns_not_in_dataframe": [
          "problem_finder_team", "program", "author", "aida_businesskey",
          "function_responsible", "tolerated_count", "reprel_changes",
          "last_modified", "owner", "fvp", "tqr"
        ],
        "notes": [
          "优化表有44列，DataFrame清洗后约25列，差异列在raw_json中可查",
          "problem_finder_team(team发现缺陷) vs team(归属team) vs detected_by(具体测试员) 三者不同",
          "reporting_class在优化表是TEXT不是列表，查询时需LIKE或JSON解析",
          "risk_score初始为NULL，需后续计算更新",
          "raw_json包含完整Octane原始数据，可json_parse获取未展平字段"
        ]
      }
    },
    {
      "id": "octane_tests",
      "name": "Octane Tests",
      "aliases": ["tests", "test", "测试", "execution", "test_run", "octane_tests"],
      "description": "用于测试执行/覆盖率等分析的数据集，来自 Octane 测试导出或本地SQLite缓存。",
      "granularity": "一行=一个测试实体（具体以导出字段为准）",
      "primary_keys": ["id"],
      "time_columns": [
        {
          "name": "creation_time",
          "meaning": "测试实体创建或记录时间（若存在）",
          "type": "datetime"
        }
      ],
      "core_dimensions": [
        {
          "name": "project",
          "aliases": ["tproject", "项目", "车系", "车型", "project_name"],
          "meaning": "项目字段（例如 idcevo / idc / mgu 等项目缩写，用于标识项目/车系）",
          "type": "string"
        },
        {
          "name": "aida_english",
          "aliases": ["aida", "top_aida", "product_area", "产品域", "领域"],
          "meaning": "AIDA 英文名（从 AIDA 字段抽取，仅保留英文文字、去掉数字/编号；用于统一口径分析）",
          "type": "string"
        },
        {
          "name": "fv",
          "aliases": ["feature team", "feature_team", "功能负责人", "负责人", "模块负责人", "dtsv"],
          "meaning": "Feature Team（DTSV 功能负责人/责任团队），用于表示该测试/用例对应的功能负责人或负责团队",
          "type": "string"
        },
        {
          "name": "id",
          "aliases": ["test_id", "execution_id", "run_id", "record_id"],
          "meaning": "Octane 测试实体/测试记录的 ID（测试数据行的唯一编号）",
          "type": "string"
        },
        {
          "name": "top_aida",
          "aliases": ["top aida", "主要aida", "主aida", "最重要aida"],
          "meaning": "团队口径的 Top AIDA：测试团队定义的最小颗粒度（验证基石），与缺陷侧 top_aida 口径一致",
          "type": "string"
        }
      ],
      "common_columns": ["id", "project", "top_aida", "aida_english", "fv"],
      "can_answer": [
        "测试覆盖/测试用例数量在项目/AIDA/FV维度的分布",
        "缺陷与测试的联动（需要明确join键）"
      ],
      "misuse_risks": [
        "测试数据的粒度可能不是“执行记录”，不要直接解读为“通过率/失败率”除非字段明确"
      ],
      "source": {
        "loader": "data_processor.load_test_data",
        "default_file_pattern": "testcase/*.json",
        "db_kind": "tests"
      },
      "optimized_table": {
        "table_name": "octane_manual_runs",
        "description": "downloader下载Manual Run原始JSON后由octane_db.py展平写入的优化查询表",
        "columns": [
          {"name": "mr_id", "type": "TEXT", "pk": true, "meaning": "Manual Run唯一ID", "octane_source": "id"},
          {"name": "name", "type": "TEXT", "meaning": "Run名称", "octane_source": "name"},
          {"name": "test_name", "type": "TEXT", "meaning": "测试用例名称", "octane_source": "test_name"},
          {"name": "test_id", "type": "TEXT", "meaning": "关联的测试用例ID", "octane_source": "test.id"},
          {"name": "creation_time", "type": "TEXT", "meaning": "创建时间", "octane_source": "creation_time"},
          {"name": "last_modified", "type": "TEXT", "meaning": "最后修改时间", "octane_source": "last_modified"},
          {"name": "started", "type": "TEXT", "meaning": "开始执行时间", "octane_source": "started"},
          {"name": "finished", "type": "TEXT", "meaning": "完成时间(对应finished_udf)", "octane_source": "finished_udf"},
          {"name": "defect_id", "type": "TEXT", "meaning": "关联的缺陷ID(可能为空)", "octane_source": "defect.id"},
          {"name": "run_team", "type": "TEXT", "meaning": "执行团队(run_team_000_udf)", "octane_source": "run_team_000_udf.name"},
          {"name": "program", "type": "TEXT", "meaning": "程序/项目", "octane_source": "program"},
          {"name": "author", "type": "TEXT", "meaning": "创建者", "octane_source": "author.name/full_name"},
          {"name": "run_by", "type": "TEXT", "meaning": "执行人/测试员", "octane_source": "run_by.name/full_name"},
          {"name": "status", "type": "TEXT", "meaning": "执行状态(Passed/Failed/Blocked/Planned等)", "octane_source": "status.name"},
          {"name": "native_status", "type": "TEXT", "meaning": "Octane原生状态值(与status可能不同,含Requires Attention等)", "octane_source": "native_status"},
          {"name": "is_completed", "type": "INTEGER", "meaning": "是否已完成(0/1)", "octane_source": "is_completed"},
          {"name": "steps_num", "type": "INTEGER", "meaning": "测试步骤数", "octane_source": "steps_num"},
          {"name": "version_stamp", "type": "INTEGER", "meaning": "版本戳", "octane_source": "version_stamp"},
          {"name": "release", "type": "TEXT", "meaning": "Release/测试事件", "octane_source": "release.name"},
          {"name": "exec_model_series", "type": "TEXT", "meaning": "车型系列(exec_model_series_udf)", "octane_source": "exec_model_series_udf.name"},
