{
  "schema_version": "1.0",
  "datasets": [
    {
      "id": "octane_defects",
      "name": "Octane Defects",
      "aliases": [
        "defects",
        "defect",
        "缺陷",
        "bug",
        "issue",
        "octane_defect",
        "work_item"
      ],
      "description": "用于缺陷分析的主数据集，来自 Octane 缺陷导出或本地SQLite缓存。",
      "granularity": "一行=一个缺陷(work_item)",
      "primary_keys": [
        "id"
      ],
      "time_columns": [
        {
          "name": "creation_time",
          "meaning": "缺陷创建时间",
          "type": "datetime"
        }
      ],
      "core_dimensions": [
        {
          "name": "project",
          "aliases": [
            "tproject",
            "项目",
            "车系",
            "车型",
            "project_name"
          ],
          "meaning": "项目/车系映射后的项目字段",
          "type": "string"
        },
        {
          "name": "aida_english",
          "aliases": [
            "aida",
            "top_aida",
            "product_area",
            "产品域",
            "领域"
          ],
          "meaning": "AIDA 英文名（从 AIDA 字段抽取，仅保留英文文字、去掉数字/编号；用于统一口径分析）",
          "type": "string"
        },
        {
          "name": "severity",
          "meaning": "缺陷严重度（如 Critical/Major/Minor）",
          "type": "string"
        },
        {
          "name": "status_phase",
          "aliases": [
            "phase",
            "status",
            "状态",
            "阶段",
            "lifecycle"
          ],
          "meaning": "缺陷状态/阶段（phase字段映射）",
          "type": "string"
        },
        {
          "name": "fv",
          "aliases": [
            "feature team",
            "feature_team",
            "功能负责人",
            "负责人",
            "模块负责人",
            "dtsv"
          ],
          "meaning": "Feature Team（DTSV 功能负责人/责任团队），用于表示该缺陷对应的功能负责人或负责团队",
          "type": "string"
        },
        {
          "name": "pu",
          "meaning": "PU / SOP字段（first_use_sop_of_function_udf映射）",
          "type": "string"
        },
        {
          "name": "tester",
          "aliases": [
            "detected_by",
            "found_by",
            "reporter",
            "发现人",
            "测试人员"
          ],
          "meaning": "缺陷发现人/测试者（detected_by映射）",
          "type": "string"
        },
        {
          "name": "id",
          "aliases": [
            "ticket_id",
            "bug_id",
            "defect_id",
            "issue_id",
            "work_item_id"
          ],
          "meaning": "Octane 缺陷/工单的 ID（ticket/bug 唯一编号）",
          "type": "string"
        },
        {
          "name": "test_week",
          "aliases": [
            "cw",
            "calendar_week",
            "测试周",
            "周"
          ],
          "meaning": "测试周（CW 周编号），一年通常有 CW01-CW52 共 52 个测试周",
          "type": "string"
        },
        {
          "name": "aidas",
          "aliases": [
            "product_areas",
            "aida_list",
            "aida集合"
          ],
          "meaning": "Octane 系统的 AIDA 多值集合字段：一个 ticket 可关联多个 AIDA",
          "type": "string"
        },
        {
          "name": "top_aida",
          "aliases": [
            "top aida",
            "主要aida",
            "主aida",
            "最重要aida"
          ],
          "meaning": "团队口径的 Top AIDA：从 aidas 中抽取的主 AIDA，是测试团队定义的最小颗粒度（验证基石）",
          "type": "string"
        },
        {
          "name": "domain",
          "aliases": [
            "solution_cluster",
            "dev_team",
            "开发团队",
            "责任团队"
          ],
          "meaning": "开发团队/责任团队（Solution Cluster 口径，用于标识负责开发/修复的团队）",
          "type": "string"
        },
        {
          "name": "matrix",
          "aliases": [
            "matrix_display",
            "severity_matrix",
            "严重矩阵",
            "严重性标签"
          ],
          "meaning": "缺陷严重性矩阵标签（用于标识严重程度分层的规则标签）",
          "type": "string"
        },
        {
          "name": "software_version",
          "aliases": [
            "sw_version",
            "version",
            "软件版本",
            "被测版本"
          ],
          "meaning": "被测软件版本（SUT 软件版本）",
          "type": "string"
        },
        {
          "name": "occurrence",
          "aliases": [
            "error_occurrence",
            "repro_rate",
            "复现率",
            "复现概率"
          ],
          "meaning": "复现概率/复现频次（描述缺陷在测试中出现的概率）",
          "type": "string"
        },
        {
          "name": "solution",
          "aliases": [
            "solution_responsible",
            "解决方案负责人",
            "解决方案责任团队"
          ],
          "meaning": "负责给出解决方案的开发团队/责任方（Solution Responsible）",
          "type": "string"
        },
        {
          "name": "parent_child",
          "aliases": [
            "parent_child_udf",
            "子票",
            "父子关系"
          ],
          "meaning": "缺陷父子关系/Child 关联状态字段（用于描述 master-child 关系）",
          "type": "string"
        },
        {
          "name": "blocking_reason",
          "aliases": [
            "blocking_reason_udf",
            "blocked_reason",
            "阻塞原因"
          ],
          "meaning": "缺陷/测试阻塞原因（导致无法推进验证或修复的原因）",
          "type": "string"
        },
        {
          "name": "ecu",
          "aliases": [
            "assigned_ecu",
            "ecu_name",
            "车内ECU"
          ],
          "meaning": "测试车内 ECU 名称（缺陷关联 ECU / 负责 ECU）",
          "type": "string"
        },
        {
          "name": "release",
          "aliases": [
            "detected_in_release",
            "release_stage",
            "释放阶段"
          ],
          "meaning": "当前软件释放的 Release 阶段（Detected in Release / Release Stage）",
          "type": "string"
        },
        {
          "name": "istep",
          "aliases": [
            "i_step",
            "milestone",
            "研发周期",
            "目标周期"
          ],
          "meaning": "车型研发目标周期的里程碑（Milestone / I-Step）",
          "type": "string"
        },
        {
          "name": "lead_model",
          "aliases": [
            "lead_model_udf",
            "引领车型",
            "标准车型"
          ],
          "meaning": "引领车型：软硬件 cluster 最先应用/落地的标准车型",
          "type": "string"
        },
        {
          "name": "tags",
          "aliases": [
            "user_tags",
            "标签",
            "tag_list"
          ],
          "meaning": "Ticket 标签集合（用于分类、过滤或流程标记）",
          "type": "string"
        },
        {
          "name": "ticket_quality",
          "aliases": [
            "tqr",
            "tqr_udf",
            "quality",
            "缺陷质量"
          ],
          "meaning": "缺陷质量（Ticket Quality / TQR，用于衡量缺陷描述、复现信息等质量）",
          "type": "string"
        }
      ],
      "field_lineage": {
        "occurrence": "error_occurrence_udf",
        "severity": "problem_severity_udf",
        "status_phase": "phase",
        "solution": "solution_responsible_udf",
        "parent_child": "parent_child_udf",
        "blocking_reason": "blocking_reason_udf",
        "pu": "first_use_sop_of_function_udf",
        "tester": "detected_by",
        "ecu": "assigned_ecu_udf",
        "release": "detected_in_release",
        "istep": "involved_i_step1_udf",
        "lead_model": "lead_model_udf",
        "software_version": "software_version_udf"
      },
      "list_field_lineage": {
        "tags": "user_tags",
        "ticket_quality": "tqr_udf",
        "aidas": "product_areas"
      },
      "common_columns": [
        "id",
        "creation_time",
        "test_week",
        "project",
        "aidas",
        "top_aida",
        "aida_english",
        "severity",
        "status_phase",
        "fv",
        "pu",
        "tester",
        "domain",
        "matrix",
        "software_version",
        "ecu_pingpong_count",
        "domain_pingpong_count",
        "topissue_risk_score",
        "topissue_recommend_reason",
        "topissue_display",
        "classification",
        "complexity",
        "child_count",
        "severity_group"
      ],
      "can_answer": [
        "不同时间/项目/AIDA/FV下缺陷数量趋势如何",
        "当前阶段分布、严重度分布是否异常",
        "高风险缺陷（按规则）集中在哪些域/团队/版本"
      ],
      "misuse_risks": [
        "仅用creation_time做趋势可能忽略状态迁移；需要明确口径（新增/存量/关闭）",
        "aida_english可能来自提取或映射，存在Unknown/不一致，需要在结论里标注覆盖率"
      ],
      "source": {
        "loader": "data_processor.load_defect_data",
        "default_file_pattern": "defect/2025_defect.json",
        "db_kind": "defects"
      },
      "optimized_table": {
        "table_name": "octane_defects",
        "description": "downloader下载原始JSON后由octane_db.py展平写入的优化查询表，Agent查询的主要目标",
        "columns": [
          {
            "name": "defect_id",
            "type": "TEXT",
            "pk": true,
            "meaning": "Octane缺陷唯一ID",
            "octane_source": "id"
          },
          {
            "name": "name",
            "type": "TEXT",
            "meaning": "缺陷标题/名称",
            "octane_source": "name"
          },
          {
            "name": "creation_time",
            "type": "TEXT",
            "meaning": "创建时间(ISO格式)",
            "octane_source": "creation_time"
          },
          {
            "name": "last_modified",
            "type": "TEXT",
            "meaning": "最后修改时间",
            "octane_source": "last_modified"
          },
          {
            "name": "team",
            "type": "TEXT",
