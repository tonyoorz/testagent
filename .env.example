# ============================================================
# PreAnalysis 项目环境变量配置模板
# 
# 使用方法：
#   cp .env.example .env
#   编辑 .env 填写真实的 API Key
#   .env 已加入 .gitignore，不会提交到版本库
# ============================================================

# ============================================================
# AI 模型配置（二选一，有内网优先用内网）
# ============================================================

# ---- DeepSeek 内网 (BMW 专用，速度更快) ----
DEEPSEEK_ACCESS_CODE=7FD25E1BD6124A1C8BF29030C8BFC43E
# DEEPSEEK_API_BASE 留空则自动使用内网地址

# ---- DeepSeek 公网备用 ----
DEEPSEEK_API_KEY_BACKUP=sk-e1a77ca98a30498ca33acc7f803f0d41
# DEEPSEEK_API_BASE_BACKUP 留空则使用 https://api.deepseek.com/v1

# ---- 智谱 ZhipuAI (GLM-4 系列) ----
ZHIPU_API_KEY=8cde7284bcfc46aea4e016fd9fc4774e.w0mFBcJxSvtlgcXh

# ============================================================
# 应用服务配置
# ============================================================

# 主看板端口 (默认 8051)
PORT=8051
HOST=0.0.0.0
DEBUG=False

# ============================================================
# 数据文件路径配置（留空则使用相对路径）
# ============================================================

# 项目根目录（留空则自动检测）
# PROJECT_ROOT=/path/to/your/project

# 数据目录（相对于项目根目录）
DATA_DIR=defect
MR_DIR=mr
AIDA_DIR=aida
DATABASE_DIR=database

# ============================================================
# OpenClaw 配置
# ============================================================
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_TOKEN=01865bfdc2209b0f2d47ae76a6c8344babaed1bdfd141778

# ============================================================
# 安全配置
# ============================================================
SECRET_KEY=please-change-this-to-a-random-string

# ============================================================
# 可选: Redis 缓存（不配置则使用内存缓存）
# ============================================================
# REDIS_URL=redis://localhost:6379/0
